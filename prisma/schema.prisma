// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
    @@map("post")
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
    @@map("account")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("session")
}

model User {
    id            String    @id @default(cuid())
    name          String?
    // 骨架阶段: 明文密码, 接入真实认证前请换成 bcrypt/argon2 哈希
    username      String    @unique
    password      String
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    roleId        String?
    role          Role?     @relation(fields: [roleId], references: [id])
    accounts      Account[]
    sessions      Session[]
    posts         Post[]

    @@map("user")
}

model Role {
    id          String     @id @default(cuid())
    name        String     @unique
    code        String     @unique
    description String?
    users       User[]
    menus       MenuRole[]
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@map("role")
}

model Menu {
    id        String     @id @default(cuid())
    parentId  String?
    parent    Menu?      @relation("MenuTree", fields: [parentId], references: [id])
    children  Menu[]     @relation("MenuTree")
    name      String
    path      String?
    icon      String?
    sort      Int        @default(0)
    visible   Boolean    @default(true)
    roles     MenuRole[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    @@index([parentId])
    @@map("menu")
}

model MenuRole {
    menuId String
    roleId String
    menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
    role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([menuId, roleId])
    @@map("menu_role")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_token")
}

// ─── 地址库 / 知识库 ───────────────────────────────
// ponytail: id 用 cuid(varchar(191)) 与 user/role 保持一致；时间字段 snake_case 用 @map；
// 不在 Prisma 层声明 onDelete/onUpdate 外键级联，由业务层保证引用完整性。
model Region {
    id         String   @id @default(cuid())
    code       String   @unique
    name       String
    level      Int
    type       String?
    parentCode String?  @map("parent_code")
    fullName   String?  @map("full_name")
    sortOrder  Int      @default(0) @map("sort_order")
    status     Int      @default(1)
    createdAt  DateTime @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    communities Community[]
    pois        Poi[]
    villages    Village[]

    @@index([parentCode])
    @@index([level])
    @@index([status])
    @@index([name])
    @@map("regions")
}

model Community {
    id        String   @id @default(cuid())
    name      String
    alias     String?
    regionId  String?  @map("region_id")
    address   Json?
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 没有原生支持;
    // 用 Unsupported 绕过类型校验,读写通过 raw SQL 处理。
    // schema 里保留列,避免 Prisma db pull 时报字段缺失。
    geom      Unsupported("geomcollection")? @map("geom")
    status    Int      @default(1)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([status])
    @@map("communities")
}

model Village {
    id        String   @id @default(cuid())
    name      String
    alias     String?
    regionId  String?  @map("region_id")
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 不支持 → Unsupported
    geom      Unsupported("geomcollection")? @map("geom")
    status    Int      @default(1)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([status])
    @@map("village")
}

model Road {
    id        String    @id @default(cuid())
    road      String
    status    Int       @default(1)
    createdAt DateTime? @map("created_at")
    updatedAt DateTime? @updatedAt @map("updated_at")

    @@index([status])
    @@map("roads")
}

model Poi {
    id        String   @id @default(cuid())
    name      String
    type      String?
    alias     String?
    regionId  String?  @map("region_id")
    address   Json?
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 不支持 → Unsupported
    geom      Unsupported("geomcollection")? @map("geom")
    status    Int      @default(1)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([type])
    @@index([status])
    @@map("pois")
}
