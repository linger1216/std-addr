// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
    @@map("post")
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
    @@map("account")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("session")
}

model User {
    id            String    @id @default(cuid())
    name          String?
    // 骨架阶段: 明文密码, 接入真实认证前请换成 bcrypt/argon2 哈希
    username      String    @unique
    password      String
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    roleId        String?
    role          Role?     @relation(fields: [roleId], references: [id])
    accounts      Account[]
    sessions      Session[]
    posts         Post[]

    @@map("user")
}

model Role {
    id          String     @id @default(cuid())
    name        String     @unique
    code        String     @unique
    description String?
    users       User[]
    menus       MenuRole[]
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@map("role")
}

model Menu {
    id        String     @id @default(cuid())
    parentId  String?
    parent    Menu?      @relation("MenuTree", fields: [parentId], references: [id])
    children  Menu[]     @relation("MenuTree")
    name      String
    path      String?
    icon      String?
    sort      Int        @default(0)
    visible   Boolean    @default(true)
    roles     MenuRole[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt

    @@index([parentId])
    @@map("menu")
}

model MenuRole {
    menuId String
    roleId String
    menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
    role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@id([menuId, roleId])
    @@map("menu_role")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_token")
}

// ─── 地址库 / 知识库 ───────────────────────────────
// ponytail: id 用 cuid(varchar(191)) 与 user/role 保持一致；时间字段 snake_case 用 @map；
// 不在 Prisma 层声明 onDelete/onUpdate 外键级联，由业务层保证引用完整性。
model Region {
    id         String   @id @default(cuid())
    code       String   @unique
    name       String
    level      Int
    type       String?
    alias      Json?    @map("alias")
    parentCode String?  @map("parent_code")
    fullName   String?  @map("full_name")
    sortOrder  Int      @default(0) @map("sort_order")
    status     Int      @default(1)
    createdAt  DateTime @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    communities Community[]
    pois        Poi[]
    villages    Village[]
    subareas    Subarea[]

    @@index([parentCode])
    @@index([level])
    @@index([status])
    @@index([name])
    @@map("region")
}

model Community {
    id        String   @id @default(cuid())
    name      String
    // 注意:DDL 里 alias 是 json 列(空串会被 MySQL 拒绝,报 3140),
    // 这里必须声明 Json?,空别名用 null 表示。
    alias     Json?
    regionId  String?  @map("region_id")
    address   Json?
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 没有原生支持;
    // 用 Unsupported 绕过类型校验,读写通过 raw SQL 处理。
    // schema 里保留列,避免 Prisma db pull 时报字段缺失。
    geom      Unsupported("geomcollection")? @map("geom")
    status    Int      @default(1)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([status])
    @@map("community")
}

model Village {
    id        String   @id @default(cuid())
    name      String
    alias     Json?
    regionId  String?  @map("region_id")
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 不支持 → Unsupported
    geom      Unsupported("geomcollection")? @map("geom")
    status    Int      @default(1)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([status])
    @@map("village")
}

model Road {
    id        String    @id @default(cuid())
    road      String
    status    Int       @default(1)
    createdAt DateTime? @map("created_at")
    updatedAt DateTime? @updatedAt @map("updated_at")

    @@index([status])
    @@map("road")
}

model Poi {
    id        String   @id @default(cuid())
    name      String
    type      String?
    // 多值别名:JSON 数组(对齐 community/village.alias)
    alias     Json?
    regionId  String?  @map("region_id")
    // 地址列表:JSON 数组(对齐 community.address)
    address   Json?
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 不支持 → Unsupported
    geom      Unsupported("geomcollection")? @map("geom")
    status    Int      @default(1)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([type])
    @@index([status])
    @@map("poi")
}

// ─── 知识库 / 地址要素 ──────────────────────────────
// 地址组件要素字典(省份/城市/区县/街道/路/小区 ...)
// 对齐 community/village 模板:对齐 label 表(单数)
model Label {
    id        String   @id @default(cuid())
    name      String   @unique
    label     String?
    status    Int      @default(1)
    // P0-6:地址要素的默认配置(集中存储,addr-sim 用)
    // data    = { randomValue?, customValue?, randomNumber?, randomChinese?, prefix?, suffix? }
    //           4 个数据源 + 默认前后缀(prefix/suffix 各为 { texts, skipRate })统一存这一个 JSON
    // prefix / suffix 列为旧数据兼容,新写入只写 data 列
    // 规则步骤不写这些字段时,生成时引用这里的默认值;写了则覆盖。
    data      Json?
    prefix    Json?
    suffix    Json?
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([status])
    @@map("label")
}

// ─── 地址模拟 / 数据模拟规则 ─────────────────────────
// 模拟地址生成规则(对应 DB 表 label_mock_rule,已建)。
// rule 列是 JSON:有序步骤数组,每步三类数据来源三选一
// (randomValue / randomNumber / randomChinese)+ prefix/suffix/skipRate。
// radio 列:占比(1~100,可空)—— 从数据提取时按出现次数占比写入,
// 生成地址时作为该规则的初始化比例。
model AddressMockRule {
    id        String   @id @default(cuid())
    name      String   @map("name")
    // 步骤数组 JSON(空规则用 null)
    rule      Json?    @map("rule")
    // 实际占比(0~100,可空)—— 导入后按样本次数自动计算
    radio     Int?     @map("radio")
    // 规则样本数(导入时写入该规则的样本次数)
    count     Int?
    // 总样本数(该规则所属导入文件的总记录数,记录/展示用)
    total     Int?
    status    Int      @default(1)
    createdAt DateTime @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([status])
    @@map("label_mock_rule")
}

model Subarea {
    id         String   @id @default(cuid())
    name       String
    alias      Json?
    regionId   String?  @map("region_id")
    // DDL 是 GEOMCOLLECTION(MySQL 空间类型),Prisma 不支持 → Unsupported
    geom       Unsupported("geomcollection")? @map("geom")
    // entity_id/entity_type:所属实体(表)/实体 ID;与子区域绑定展示
    entityId   String?  @map("entity_id")
    entityType String?  @map("entity_type")
    // property:子区域属性(JSON),如 {"building":["1","3","A"],"floor":["2","5"]}
    property   Json?    @map("property")
    address    Json?
    status     Int      @default(1)
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    region Region? @relation(fields: [regionId], references: [id])

    @@index([regionId])
    @@index([status])
    @@map("subarea")
}

// ─── 标准地址库 ────────────────────────────────────
// 原始地址 → 标准地址(标准化流水线产物):
// 27 个地址要素(与 label 表 name 对齐)+ 标准评分(0-10)+ 状态/时间。
// group 是 MySQL 关键字 → 列名用 group_field(Prisma 字段 groupField + @map)。
model StdAddress {
    id          String   @id @default(cuid())
    // 原始地址
    rawAddress  String   @map("raw_address")
    // 标准地址(标准化后)
    stdAddress  String?  @map("std_address")
    // 标准评分 0-10(一位小数)
    stdScore    Decimal? @map("std_score") @db.Decimal(4, 1)
    // —— 27 个地址要素(label.name 对齐)——
    province    String?  @map("province")
    city        String?  @map("city")
    district    String?  @map("district")
    street      String?  @map("street")
    town        String?  @map("town")
    community   String?  @map("community")
    village     String?  @map("village")
    subarea     String?  @map("subarea")
    zhai        String?  @map("zhai")
    road        String?  @map("road")
    lane        String?  @map("lane")
    alley       String?  @map("alley")
    subLane     String?  @map("sub_lane")
    roadNumber  String?  @map("road_number")
    building    String?  @map("building")
    unit        String?  @map("unit")
    team        String?  @map("team")
    groupField  String?  @map("group_field")
    floor       String?  @map("floor")
    room        String?  @map("room")
    direction   String?  @map("direction")
    other       String?  @map("other")
    poi         String?  @map("poi")
    expressway  String?  @map("expressway")
    highway     String?  @map("highway")
    locationType String? @map("location_type")
    // 状态:1 启用 / 0 禁用
    status      Int      @default(1)
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([status])
    @@index([createdAt])
    @@map("std_address")
}

// ─── 系统设置 ──────────────────────────────────────
// key-value 配置表:系统名称/描述(sys.name/sys.description)、
// 模型服务 URL(model.serviceUrl,地址解析模型 API 端口)。
model SysSetting {
    key       String   @id
    value     Json?
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("sys_setting")
}
